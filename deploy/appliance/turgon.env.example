# /etc/turgon/turgon.env: read by turgon-appliance and turgon-console.
# Readable by root and the turgon user only (mode 0640): it holds secrets.

# Turgon's own state (audit log, cursors, idempotency, cross-references).
TURGON_DATABASE_URL=postgres://turgon:CHANGE-ME@127.0.0.1:5432/turgon?sslmode=disable
# The appliance's Temporal server (turgon-temporal.service), or your own.
TURGON_TEMPORAL_ADDRESS=127.0.0.1:7233
TURGON_TEMPORAL_NAMESPACE=default

# Run only specs signed by one of these keys (recommended).
#TURGON_TRUSTED_KEYS=/etc/turgon/trusted-keys.pem

# Connection secrets: `turgon secrets <spec>` lists where each is read.
# In this file, as variables, e.g.
#TURGON_SECRET_ERP_DB_DSN=postgres://...
#TURGON_SECRET_SALESFORCE_PROD_JWT={"loginUrl": ...}
# or from OpenBao / HashiCorp Vault (KV v2: openbao://erp-db/dsn is the key
# dsn of secret/data/erp-db), signing in with an AppRole whose secret ID is
# in a file only the turgon user can read:
#TURGON_SECRETS=openbao
#TURGON_OPENBAO_ADDR=https://openbao.example.com:8200
#TURGON_OPENBAO_CACERT=/etc/turgon/openbao-ca.pem
#TURGON_OPENBAO_AUTH=approle
#TURGON_OPENBAO_ROLE=<role id>
#TURGON_OPENBAO_SECRET_ID_FILE=/etc/turgon/openbao-secret-id
# or from the cloud's secret manager, with the VM's identity (instance role,
# managed identity, service account): one JSON secret per connection.
#TURGON_SECRETS=aws            # or azure, gcp
#TURGON_SECRETS_PREFIX=turgon/
#TURGON_AWS_REGION=eu-central-1
#TURGON_AZURE_VAULT_URL=https://acme-turgon.vault.azure.net
#TURGON_GCP_PROJECT=acme-prod

# Notifications about approvals, steward work and failed compensations.
#TURGON_NOTIFY_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
#TURGON_CONSOLE_URL=https://turgon.example.com

# Extra arguments.
TURGON_APPLIANCE_ARGS=--worker-arg=--poll=2s
TURGON_CONSOLE_ARGS=--auth dev --dev-user admin@example.com --listen 127.0.0.1:8080
