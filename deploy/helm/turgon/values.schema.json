{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["image", "temporal", "database", "workers", "console", "networkPolicy"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "temporal": {
      "type": "object",
      "required": ["address", "namespace"],
      "properties": { "address": { "type": "string", "minLength": 1 }, "namespace": { "type": "string", "minLength": 1 } }
    },
    "database": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string", "minLength": 1 },
        "cloudNativePG": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean" }, "instances": { "type": "integer", "minimum": 1 } }
        }
      }
    },
    "specs": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 40 },
      "additionalProperties": { "type": "string", "minLength": 2 }
    },
    "workers": {
      "type": "object",
      "properties": {
        "replicas": { "type": "integer", "minimum": 0 },
        "secretEnvFrom": { "type": "array", "items": { "type": "string" } }
      }
    },
    "console": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "auth": {
          "type": "object",
          "properties": {
            "mode": { "const": "proxy" },
            "trustedProxies": { "type": "array", "items": { "type": "string" } },
            "approverGroup": { "type": "string" },
            "stewardGroup": { "type": "string" }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "allowAllEgress": { "type": "boolean" },
        "egressRules": { "type": "array" },
        "consoleFrom": { "type": "array" },
        "agentsFrom": { "type": "array" }
      }
    },
    "agents": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "specs": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" } },
        "writes": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" } },
        "wait": { "type": "string", "pattern": "^[0-9]+(ms|s|m)$" },
        "gateway": {
          "type": "object",
          "properties": {
            "image": {
              "type": "object",
              "required": ["repository", "tag"],
              "properties": {
                "repository": { "type": "string", "minLength": 1 },
                "tag": { "type": "string", "minLength": 1 },
                "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
              }
            },
            "replicas": { "type": "integer", "minimum": 0 },
            "issuer": { "type": "string" },
            "audiences": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "jwksURL": { "type": "string", "pattern": "^(https?://.+)?$" },
            "claims": {
              "type": "object",
              "additionalProperties": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$" }
            },
            "rateLimit": { "type": "string", "pattern": "^([0-9]+/[0-9]+(ms|s|m|h))?$" }
          }
        }
      }
    }
  }
}
