{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["image", "temporal", "database", "workers", "console", "networkPolicy"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "temporal": {
      "type": "object",
      "required": ["address", "namespace"],
      "properties": {
        "address": { "type": "string", "minLength": 1 },
        "namespace": { "type": "string", "minLength": 1 },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "serverName": { "type": "string" },
            "existingSecret": { "type": "string" },
            "caKey": { "type": "string" },
            "certKey": { "type": "string" },
            "keyKey": { "type": "string" }
          }
        },
        "existingSecret": { "type": "string" },
        "apiKeyKey": { "type": "string", "minLength": 1 },
        "payloadKeysKey": { "type": "string", "minLength": 1 }
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string", "minLength": 1 },
        "cloudNativePG": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "instances": { "type": "integer", "minimum": 1 },
            "backup": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "destinationPath": { "type": "string" },
                "endpointURL": { "type": "string" },
                "credentialsSecret": { "type": "string" },
                "retentionPolicy": { "type": "string", "pattern": "^[1-9][0-9]*[dwm]$" },
                "schedule": { "type": "string" },
                "serverName": { "type": "string" }
              }
            },
            "recovery": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "serverName": { "type": "string" },
                "targetTime": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "specs": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 40 },
      "additionalProperties": { "type": "string", "minLength": 2 }
    },
    "workers": {
      "type": "object",
      "properties": {
        "pollers": { "anyOf": [{ "const": "auto" }, { "type": "integer", "minimum": 1, "maximum": 500 }] },
        "replicas": { "type": "integer", "minimum": 0 },
        "secretEnvFrom": { "type": "array", "items": { "type": "string" } }
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 1 },
        "defaultReplicas": { "type": "integer", "minimum": 0 },
        "resources": { "type": "object" }
      }
    },
    "console": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "auth": {
          "type": "object",
          "properties": {
            "mode": { "enum": ["proxy", "oidc"] },
            "trustedProxies": { "type": "array", "items": { "type": "string" } },
            "approverGroup": { "type": "string" },
            "stewardGroup": { "type": "string" },
            "operatorGroup": { "type": "string" },
            "viewerGroup": { "type": "string" },
            "oidc": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "issuer": { "type": "string" },
                "clientID": { "type": "string" },
                "url": { "type": "string" },
                "scopes": { "type": "array", "items": { "type": "string" } },
                "groupsClaim": { "type": "string" },
                "sessionTTL": { "type": "string", "pattern": "^[0-9]+(h|m)$" },
                "existingSecret": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "specSigning": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "trustedKeys": { "type": "string", "pattern": "^$|-----BEGIN PUBLIC KEY-----" } }
    },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "podMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "interval": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" },
            "labels": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        },
        "scrapeFrom": { "type": "array" },
        "rules": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "labels": { "type": "object", "additionalProperties": { "type": "string" } },
            "runFailureRatio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "pollStalledMinutes": { "type": "integer", "minimum": 1 },
            "breakerOpenMinutes": { "type": "integer", "minimum": 1 },
            "webhookRejections": { "type": "integer", "minimum": 1 },
            "cdcRetainedWALMiB": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "allowAllEgress": { "type": "boolean" },
        "egressRules": { "type": "array" },
        "consoleFrom": { "type": "array" },
        "agentsFrom": { "type": "array" }
      }
    },
    "splink": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "url": { "type": "string", "pattern": "^(https?://[^/]+/?)?$" },
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string" },
            "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "replicas": { "type": "integer", "minimum": 0 },
        "retrain": { "type": "integer", "minimum": 10 },
        "prior": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
        "database": {
          "type": "object",
          "properties": {
            "existingSecret": { "type": "string" },
            "existingSecretKey": { "type": "string", "minLength": 1 }
          }
        },
        "existingSecret": { "type": "string" }
      }
    },
    "agents": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "specs": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" } },
        "writes": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$" } },
        "wait": { "type": "string", "pattern": "^[0-9]+(ms|s|m)$" },
        "gateway": {
          "type": "object",
          "properties": {
            "image": {
              "type": "object",
              "required": ["repository", "tag"],
              "properties": {
                "repository": { "type": "string", "minLength": 1 },
                "tag": { "type": "string", "minLength": 1 },
                "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
              }
            },
            "replicas": { "type": "integer", "minimum": 0 },
            "issuer": { "type": "string" },
            "audiences": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "jwksURL": { "type": "string", "pattern": "^(https?://.+)?$" },
            "claims": {
              "type": "object",
              "additionalProperties": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$" }
            },
            "rateLimit": { "type": "string", "pattern": "^([0-9]+/[0-9]+(ms|s|m|h))?$" }
          }
        }
      }
    }
  }
}
