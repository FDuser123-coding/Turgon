{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["image", "temporal", "database", "workers", "console", "networkPolicy"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "temporal": {
      "type": "object",
      "required": ["address", "namespace"],
      "properties": { "address": { "type": "string", "minLength": 1 }, "namespace": { "type": "string", "minLength": 1 } }
    },
    "database": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "existingSecretKey": { "type": "string", "minLength": 1 },
        "cloudNativePG": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean" }, "instances": { "type": "integer", "minimum": 1 } }
        }
      }
    },
    "specs": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 40 },
      "additionalProperties": { "type": "string", "minLength": 2 }
    },
    "workers": {
      "type": "object",
      "properties": {
        "replicas": { "type": "integer", "minimum": 0 },
        "secretEnvFrom": { "type": "array", "items": { "type": "string" } }
      }
    },
    "console": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "auth": {
          "type": "object",
          "properties": {
            "mode": { "const": "proxy" },
            "trustedProxies": { "type": "array", "items": { "type": "string" } },
            "approverGroup": { "type": "string" }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "allowAllEgress": { "type": "boolean" },
        "egressRules": { "type": "array" },
        "consoleFrom": { "type": "array" }
      }
    }
  }
}
