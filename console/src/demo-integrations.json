  "flows": [
    {
      "name": "ecc-orders-to-erp",
      "version": "1.0.0",
      "description": "An order saved in SAP ECC, sent as an ORDRSP IDoc, becomes a sales order in the warehouse ERP database.",
      "level": "L1",
      "deployable": true,
      "trigger": {
        "system": "ecc-prod",
        "event": "SalesOrder.Created",
        "delivery": "polling"
      },
      "steps": [
        {
          "kind": "map",
          "mapping": "ecc-order-confirmation-to-sales-order@1.0.0",
          "from": "ecc-prod.SalesOrder",
          "to": "model.SalesOrder",
          "fields": 6
        },
        {
          "kind": "resolve",
          "entity": "model.Customer",
          "strategy": "exact"
        },
        {
          "kind": "write",
          "entity": "SalesOrder",
          "system": "erp-db",
          "operation": "create-sales-order",
          "risk": "high",
          "approval": "policy",
          "simulation": "rollback",
          "compensation": "cancel-sales-order"
        }
      ],
      "targets": [
        "erp-db"
      ],
      "slo": "p95 5s"
    },
    {
      "name": "hubspot-won-deals-to-dynamics",
      "version": "1.0.0",
      "description": "A deal won in HubSpot becomes a sales order in Dynamics 365; the order number is written back to the deal.",
      "level": "L1",
      "deployable": true,
      "trigger": {
        "system": "hubspot-crm",
        "event": "Deal.Won",
        "delivery": "polling"
      },
      "steps": [
        {
          "kind": "map",
          "mapping": "hubspot-deal-to-order@1.0.0",
          "from": "hubspot-crm.Deal",
          "to": "model.SalesOrder",
          "fields": 6
        },
        {
          "kind": "resolve",
          "entity": "model.Customer",
          "strategy": "probabilistic"
        },
        {
          "kind": "map",
          "mapping": "sales-order-to-dynamics-order@1.0.0",
          "from": "model.SalesOrder",
          "to": "model.SalesOrder",
          "fields": 5
        },
        {
          "kind": "write",
          "entity": "SalesOrder",
          "system": "dynamics-crm",
          "operation": "create-sales-order",
          "risk": "high",
          "approval": "policy",
          "simulation": "preview",
          "compensation": "delete-sales-order"
        },
        {
          "kind": "map",
          "mapping": "sales-order-to-hubspot-link@1.0.0",
          "from": "model.SalesOrder",
          "to": "model.Deal",
          "fields": 2
        },
        {
          "kind": "write",
          "entity": "Deal",
          "system": "hubspot-crm",
          "operation": "link-deal",
          "risk": "low",
          "approval": "policy",
          "simulation": "preview",
          "compensation": "unlink-deal"
        }
      ],
      "targets": [
        "dynamics-crm",
        "hubspot-crm"
      ],
      "slo": "p95 10s"
    },
