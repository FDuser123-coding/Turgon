// The stack host interface (architecture §18.4). Plugins may only propose
// changes; writes still pass the write guard, approvals and audit.
package porter:stack@0.1.0;

interface types {
  variant error-code { denied, not-found, invalid(string) }
  record entity-ref { kind: string, id: string }
}

interface entities {
  use types.{error-code, entity-ref};
  get: func(ref: entity-ref) -> result<string, error-code>;
  propose-change: func(ref: entity-ref, patch: string) -> result<string, error-code>;
}

interface events {
  use types.{error-code};
  publish: func(topic: string, payload: list<u8>) -> result<_, error-code>;
}

world logic-plugin {
  import entities;
  import events;
  export handle: func(event: list<u8>) -> result<_, string>;
}
